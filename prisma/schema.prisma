generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  ADMIN
}

enum RequestStatus {
  PENDING
  APPROVED
  REJECTED
}

enum ConsultationStatus {
  NEW
  PAYMENT_CONFIRMED
  ACCEPTED
  REJECTED
  CHANGED
  COMPLETED
  CANCELLED
}

model User {
  id              Int       @id @default(autoincrement())
  fullName        String
  email           String    @unique
  passwordHash    String
  role            Role      @default(USER)
  isActive        Boolean   @default(true)
  trialStartDate  DateTime  @default(now())
  trialExpiryDate DateTime
  // آخر تغيير لكلمة المرور: أي جلسة أقدم منه تصبح غير صالحة
  passwordChangedAt DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  subscriptions   Subscription[]
  consultations   Consultation[]
  paymentRequests PaymentRequest[]
  educationalContentUpdates EducationalContentOverride[] @relation("EducationalContentUpdatedBy")
  educationalQuestionUpdates EducationalQuestion[] @relation("EducationalQuestionUpdatedBy")
  contentCustomizations UserContentCustomization[]
  eventSequenceGroups   EventSequenceGroup[] @relation("EventSequenceOwner")
  passwordResetCodes    PasswordResetCode[]
  progress              UserProgress?
}

model Category {
  id        Int      @id @default(autoincrement())
  name      String
  imageUrl  String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items     Item[]
}

model Item {
  id         Int      @id @default(autoincrement())
  categoryId Int
  title      String
  speechText String
  imageUrl   String
  audioUrl   String?
  isActive   Boolean @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  category   Category      @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  variants   ItemVariant[]
}

model ItemVariant {
  id         Int      @id @default(autoincrement())
  itemId     Int
  title      String
  speechText String
  imageUrl   String
  audioUrl   String?
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  item       Item     @relation(fields: [itemId], references: [id], onDelete: Cascade)
}

model PaymentRequest {
  id          Int           @id @default(autoincrement())
  userId      Int
  userName    String?
  userEmail   String?
  packageName String
  price       String
  receiptUrl  String
  status      RequestStatus @default(PENDING)
  decidedAt   DateTime?
  planId        Int?
  durationType  String?
  durationValue Int?
  paymentMethod String   @default("cliq")
  rejectionReason String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  subscription Subscription?
  plan         SubscriptionPlan? @relation(fields: [planId], references: [id], onDelete: SetNull)

  @@index([userId, status])
}

model Subscription {
  id               Int      @id @default(autoincrement())
  userId           Int
  paymentRequestId Int?     @unique
  status           String   @default("active")
  planName         String?
  planMonths       Int?
  amount           String?
  startDate        DateTime @default(now())
  expiryDate       DateTime
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  // Apple In-App Purchase
  provider                   String    @default("manual")
  appleOriginalTransactionId String?   @unique
  appleProductId             String?
  appleLatestReceipt         String?
  appleEnvironment           String?
  appleLastCheckedAt         DateTime?

  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  paymentRequest PaymentRequest? @relation(fields: [paymentRequestId], references: [id], onDelete: SetNull)

  @@index([userId, status, expiryDate])
  @@index([provider])
}

model SpecialistAvailability {
  id              Int            @id @default(autoincrement())
  specialist      String
  startAt         DateTime
  durationMinutes Int
  isAvailable     Boolean        @default(true)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  consultations   Consultation[]

  @@unique([specialist, startAt, durationMinutes])
  @@index([isAvailable, startAt])
}

model Consultation {
  id               Int                    @id @default(autoincrement())
  userId           Int?
  availabilityId   Int?
  userName         String?
  userEmail        String?
  phone            String?
  specialist       String
  message          String?
  receiptUrl       String?
  durationMinutes  Int?
  priceJod         Int?
  status           ConsultationStatus     @default(NEW)
  rejectionReason  String?
  date             DateTime?
  time             String?
  createdAt        DateTime               @default(now())
  updatedAt        DateTime               @updatedAt

  user             User?                  @relation(fields: [userId], references: [id], onDelete: SetNull)
  availability     SpecialistAvailability? @relation(fields: [availabilityId], references: [id], onDelete: Restrict)

  @@index([status, createdAt])
  @@index([availabilityId])
}

model JourneyStep {
  id        Int      @id @default(autoincrement())
  title     String
  imageUrl  String
  sortOrder Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}



model EducationalContentOverride {
  id          String   @id
  unitId      String
  title       String
  speechText  String
  imageUrl    String?
  audioUrl    String?
  isOverride  Boolean  @default(false)
  targetKey   String?
  updatedById Int
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  updatedBy User @relation("EducationalContentUpdatedBy", fields: [updatedById], references: [id], onDelete: Cascade)

  @@index([unitId])
  @@index([targetKey])
}


model EducationalQuestion {
  id           String   @id
  unitId       String
  itemKey      String
  sourceKey    String?
  question     String
  speechText   String
  correctTitle String
  options      Json
  // choice = اختيار من صور/كلمات، true_false = صح وخطأ
  type         String   @default("choice")
  // صورة السؤال نفسه (اختيارية)
  imageUrl     String?
  // null = سؤال عام من الأدمن، رقم = سؤال أضافه مستخدم لحسابه فقط
  ownerId      Int?
  isActive     Boolean  @default(true)
  sortOrder    Int      @default(0)
  isOverride   Boolean  @default(false)
  updatedById  Int
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  updatedBy User @relation("EducationalQuestionUpdatedBy", fields: [updatedById], references: [id], onDelete: Cascade)

  @@index([unitId, itemKey])
  @@index([sourceKey])
  @@index([ownerId])
}

model UserContentCustomization {
  id         Int      @id @default(autoincrement())
  userId     Int
  contentKey String
  title      String
  speechText String
  imageUrl   String?
  audioUrl   String?
  data       Json?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, contentKey])
  @@index([userId])
}


model AdminNotification {
  id        Int      @id @default(autoincrement())
  title     String
  body      String
  type      String
  sourceId  Int
  route     String?
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([type, sourceId])
  @@index([isRead, createdAt])
}

// ===== تسلسل الأحداث (Event Sequences) =====
// مجموعة مستقلة لها اسم وصورة غلاف ووصف اختياري، وبداخلها أحداث مرتبة.
// ownerId = null  => مجموعة عامة يديرها الأدمن وتظهر لكل المستخدمين.
// ownerId = <id>  => مجموعة خاصة بحساب المستخدم وتُستعاد على أي جهاز.
model EventSequenceGroup {
  id            Int      @id @default(autoincrement())
  title         String
  description   String?
  coverImageUrl String?
  sortOrder     Int      @default(0)
  isActive      Boolean  @default(true)
  ownerId       Int?
  // مفتاح يرسله التطبيق لمنع تكرار المجموعة عند إعادة المزامنة
  clientId      String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  owner  User?                @relation("EventSequenceOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  events EventSequenceEvent[]

  @@unique([ownerId, clientId])
  @@index([ownerId, isActive, sortOrder])
}

model EventSequenceEvent {
  id          Int      @id @default(autoincrement())
  groupId     Int
  title       String
  description String?
  imageUrl    String?
  audioUrl    String?
  sortOrder   Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  group EventSequenceGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@index([groupId, sortOrder])
}

// رموز استعادة كلمة المرور (تُخزَّن مشفّرة، صالحة لمدة قصيرة، ولمرة واحدة)
model PasswordResetCode {
  id        Int       @id @default(autoincrement())
  userId    Int
  codeHash  String
  expiresAt DateTime
  attempts  Int       @default(0)
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

// تقدّم الطفل في البرنامج التعليمي محفوظ في الحساب
// (يُستعاد بعد حذف التطبيق أو عند الدخول من جهاز آخر)
model UserProgress {
  userId    Int      @id
  data      Json
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// خطط الاشتراك: يحددها الأدمن (الاسم، السعر، المدة) من لوحة التحكم
model SubscriptionPlan {
  id            Int      @id @default(autoincrement())
  name          String
  description   String?
  price         String
  currency      String   @default("JOD")
  durationType  String   @default("months") // months | days
  durationValue Int      @default(1)
  isActive      Boolean  @default(true)
  isFeatured    Boolean  @default(false)
  sortOrder     Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  paymentRequests PaymentRequest[]
}

// إعدادات عامة يعدّلها الأدمن (مثل بيانات الدفع عبر CliQ)
model AppSetting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
}
